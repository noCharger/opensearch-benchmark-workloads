{
  "name": "ppl-check-with-calcite",
  "default": false,
  "description": "Test procedure to check if PPL operations work with configurable Calcite setting",
  "schedule": [
    {
      "operation": "set-calcite-enabled",
      "iterations": 1,
      "clients": 1
    },
    {
      "operation": "{{ operation }}",
      "warmup-iterations": 1,
      "iterations": 1,
      "target-throughput": 1,
      "clients": 1,
      "request-timeout": 30
    }
  ]
}